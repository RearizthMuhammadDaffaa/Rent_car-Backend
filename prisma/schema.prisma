generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      RoleStatus @default(CUSTOMER)
  booking Bookings[]
  documents UserDocuments?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
}

model Vehicles {
  id               String          @id @default(uuid())
  category_id      String
  brand_id         String
  plate_number     String
  model            String
  year             Int
  pricePerDay      Decimal
  color            String
  seat             String
  status           Status_vehicles @default(AVAILABLE)
  thumbnail        String
  thumbnailPublicId String?
  description      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  VehicleImage     VehicleImage[]
  bookings Bookings[]

  category Vehicle_Categories @relation(fields: [category_id], references: [id])

  brand Brands @relation(fields: [brand_id],references: [id])
}

model Brands {
  id   String @id @default(uuid())
  name String
  logo String?
  logoPublicId String?

  vehicles Vehicles[]
}

model Vehicle_Categories {
  id          String   @id @default(uuid())
  name        String
  description String?

  vehicles Vehicles[]
}

enum RoleStatus {
  GUEST
  CUSTOMER
  ADMIN
  SUPERADMIN
}

enum Status_vehicles {
  AVAILABLE
  BOOKED
  MAINTENANCE
  INACTIVE
}

model Coupons {
  id String   @id @default(uuid())
  code String  @unique
  type CouponsType @default(PERCENTAGE)
  discountValue Decimal
  usageLimit Int
  usedCount Int
  maximumDiscount  Decimal
  expiredAt DateTime
  isActive Boolean
  bookings Bookings[]

  createdAt    DateTime        @default(now())
}

enum CouponsType {
  FIXED
  PERCENTAGE
}

model VehicleImage {
  id            String   @id @default(uuid())
  vehicle_id    String
  image_url     String
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

   vehicle Vehicles @relation(fields: [vehicle_id], references: [id])
}

model Bookings {
  id            String   @id @default(uuid())
  user_id       String 
  car_id        String
  coupon_id     String?
  pickup_at     DateTime
  return_at     DateTime
  total_days    Int
  subtotal      Decimal
  grandTotal    Decimal
  pricePerDay   Decimal? @db.Decimal(12,2)
  tax           Decimal?
  discount      Decimal?
  status        BookingStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  rental Rental[]

  user User @relation(fields: [user_id],references: [id])
  car Vehicles @relation(fields: [car_id],references: [id])
  coupon Coupons? @relation(fields: [coupon_id],references: [id])
   // Availability query
  @@index([car_id, pickup_at, return_at])

  // User booking history
  @@index([user_id])

  // Coupon lookup
  @@index([coupon_id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum RentalStatus {
  RESERVED
  PICKED_UP
  ONGOING
  RETURNED
  COMPLETED
}

model Rental {
  id String   @id @default(uuid())
  Booking_id String 
  actual_pickup_at DateTime
  actual_return_at DateTime
  late_fee Decimal
  damage_fee Decimal
  Status RentalStatus @default(RESERVED)
  createdAt    DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  booking Bookings @relation(fields: [Booking_id],references: [id])

}

model UserDocuments { 
  id String @id @default(uuid()) 
  user_id String 
  ktp_url String? 
  ktp_public_id String?
  sim_url String? 
  sim_public_id String?
  status DocumentStatus @default(PENDING) 
  createdAt DateTime @default(now()) 
  updatedAt DateTime @default(now()) @updatedAt 
  user User @relation(fields: [user_id], references: [id]) 
  @@unique([user_id]) 
  @@index([status]) 
  
  } 
  
  enum DocumentStatus {
     PENDING 
     APPROVED 
     REJECTED 
    }




